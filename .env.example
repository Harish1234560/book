# ===== Athenaeum Bookstore — Environment Variables =====

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=your-postgres-connection-string

# Auth
AUTH_SECRET=generate-a-random-32-char-string
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments — Razorpay (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payments — Stripe (International)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Athenaeum Books <hello@athenaeum.in>"

# Image uploads (Cloudinary or UploadThing)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Store
STORE_NAME="Athenaeum"
STORE_CURRENCY=INR
STORE_GSTIN=
STORE_ADDRESS="123 KG Road, Bengaluru, Karnataka 560001"
STORE_PHONE="+91 80000 00000"
STORE_EMAIL="hello@athenaeum.in"
